# =============================================================================
# PPH Trading Computer — Environment Configuration
# =============================================================================

# --- PostgreSQL Database ---
POSTGRES_USER=pph
POSTGRES_PASSWORD=pph_secret
POSTGRES_DB=pph_trading
# Inside Docker Compose, listener and bot connect to hostname `db` on pph-net.
# For host scripts (if running outside Docker with a local/forwarded Postgres):
DATABASE_URL=postgres://pph:pph_secret@db:5432/pph_trading

# --- EDDN ZeroMQ Relay ---
EDDN_ZMQ_URL=tcp://eddn.edcd.io:9500
EDDN_IDLE_TIMEOUT_MS=60000

# --- EDSM Coordinate & Population Backfill Resolver ---
EDSM_RESOLVER_ENABLED=true
EDSM_RATE_LIMIT_MS=2000

# --- Time-To-Live (TTL) & Cleanup Configuration ---
# How often the TTL cleanup worker runs (in minutes)
TTL_CLEANUP_INTERVAL_MINUTES=15
# Fleet Carrier market listings TTL (in hours) - default 48h (2 days)
TTL_CARRIER_MARKET_HOURS=48
# Permanent station & colonisation vessel market listings TTL (in hours) - default 168h (7 days)
TTL_STATION_MARKET_HOURS=168
# Inactive Fleet Carriers & Colonisation Vessels metadata TTL (in days) - default 14 days
TTL_TRANSIENT_STATION_DAYS=14
# Stale minor faction BGS state snapshots TTL (in days) - default 14 days
TTL_FACTION_STATE_DAYS=14

# --- Discord Bot Configuration ---
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here
# Optional: Set your PPH Discord server ID for instant guild-scoped slash command registration
DISCORD_GUILD_ID=your_discord_guild_id_here
